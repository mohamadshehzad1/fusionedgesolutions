{
  "framework": "nextjs",
  "regions": ["lhr1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/housing-disrepair/damp-mould",
      "destination": "/services/damp-and-mould-claims",
      "permanent": true
    },
    {
      "source": "/housing-disrepair/heating",
      "destination": "/services/heating-and-boiler-claims",
      "permanent": true
    },
    {
      "source": "/housing-disrepair/structural",
      "destination": "/services/structural-disrepair-claims",
      "permanent": true
    },
    {
      "source": "/housing-disrepair/pests",
      "destination": "/services/pest-infestation-claims",
      "permanent": true
    },
    {
      "source": "/housing-disrepair/calculator",
      "destination": "/compensation-calculator",
      "permanent": true
    },
    {
      "source": "/housing-disrepair/rights",
      "destination": "/housing-disrepair-claims/fitness-for-human-habitation-act",
      "permanent": true
    }
  ]
}
